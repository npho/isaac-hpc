# isaac-sim.def

#Bootstrap: docker
#From: nvidia/cuda:12.1.1-runtime-ubuntu22.04

# https://catalog.ngc.nvidia.com/orgs/nvidia/collections/cuda_toolkit/artifacts
# apptainer pull cuda_12.1.1-runtime-ubuntu22.04.sif docker://nvidia/cuda:12.1.1-runtime-ubuntu22.04

Bootstrap: localimage
From: cuda_12.1.1-runtime-ubuntu22.04.sif

%arguments
    ISAAC_VERSION=5.1.0
    SRC=/usr/local/src

%labels
    Author npho@uw.edu
    Version {{ ISAAC_VERSION }}

%help
    An Apptainer native implementation of Isaac Sim.

%setup
    # Vulkan Drivers
    if [ -f "vulkan.run" ]; then
        echo "Vulkan drivers exist!"
    else
        echo "Downloading Vulkan drivers..."
        # https://www.nvidia.com/en-us/drivers/details/247720/
        #curl -o vulkan.run https://us.download.nvidia.com/XFree86/Linux-x86_64/570.169/NVIDIA-Linux-x86_64-570.169.run
    fi

%files
    # Vulkan
    #nvidia_icd.json /etc/vulkan/icd.d/
    #nvidia_layers.json /etc/vulkan/implicit_layer.d/

    # Python
    pyproject.toml /workspace/pyproject.toml
    uv.lock /workspace/uv.lock
    #. /workspace/src

%post
    # Install supporting packages
    export DEBIAN_FRONTEND=noninteractive

    apt update
    apt install -y \
    	curl \
        libgl1 \
        libglib2.0-0 \
        libvulkan1 \
        vulkan-tools \
        libx11-6 \
        libxrandr2 \
        libxinerama1 \
        libxcursor1 \
	zsh

    # Setup uv for Python stuff
    export UV_INSTALL_DIR=/bin/
    curl -LsSf https://astral.sh/uv/install.sh | sh

    # UV parameters
    # https://docs.astral.sh/uv/reference/environment/
    UV_CONCURRENT_DOWNLOADS=100
    UV_CONCURRENT_BUILDS=100
    UV_CONCURRENT_INSTALLS=100
    UV_COMPILE_BYTECODE=True
    
    # Python environment setup
    export ACCEPT_EULA=Y
    export OMNI_KIT_ACCEPT_EULA=YES
    
    cd /workspace
    uv python install 3.12
    uv venv .venv --python 3.12

    # Synchronize packages from frozen lockfile
    uv sync --frozen --no-dev --compile-bytecode

    # Project specific code dependencies
    if [ -f "/workspace/src/pyproject.toml" ]; then
        cd /workspace/src && uv pip install --no-deps -e .
    fi
    
    # Clean up
    apt clean
    apt autoremove
    rm -rf /var/lib/apt/lists/*    
    uv cache clean

    # Testing
    mkdir -p /root/.nvidia-omniverse /root/.local/share/ov /tmp/nvidia
    chmod -R 777 /root/.nvidia-omniverse /root/.local/share/ov /tmp/nvidia

%runscript
    exec python "$@"
    
%environment
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    export ACCEPT_EULA=Y
    export OMNI_KIT_ACCEPT_EULA=YES
    export VIRTUAL_ENV=/workspace/.venv
    export PATH=/workspace/.venv/bin:${PATH}

%test
    export PATH=/workspace/.venv/bin:${PATH}
    export OMNI_KIT_ACCEPT_EULA=YES

    # Setup %test to use /tmp for Omniverse loggers
    export HOME=/tmp
    export OMNI_USER_DATA_DIR=/tmp/nvidia/omniverse
    export OMNI_CACHE_DIR=/tmp/nvidia/cache
    
    # 1. Verify Python version is 3.11
    python -c "import sys; assert sys.version_info[:2] == (3, 11), f'Expected 3.11, got {sys.version}'"

    # 2. Verify PyTorch is compiled with CUDA support
    python -c "import torch; assert torch.version.cuda is not None, 'PyTorch was not built with CUDA!'"

    # 3. Verify packages import cleanly
    python -c "import rsl_rl; print('[TEST] rsl-rl imported successfully')"
    python -c "import isaacsim; print('[TEST] Isaac Sim imported successfully')"
