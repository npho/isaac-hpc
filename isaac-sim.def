# isaac-sim.def

#Bootstrap: docker
#From: nvidia/cuda:12.8.2-runtime-ubuntu24.04

Bootstrap: localimage
From: cuda_12.8.2-runtime-ubuntu24.04.sif

%arguments
    ISAAC_VERSION=6.1.0

%labels
    Author npho@uw.edu
    Version {{ ISAAC_VERSION }}

%help
    An Apptainer native implementation of Isaac Sim and Isaac Lab.

%setup
    # `build --nv` runs %post writable, where --nv only binds onto paths that already exist.
    # Empty placeholders so the host's driver data files are bound during the shader warm-up;
    # headless Vulkan fails (ERROR_INCOMPATIBLE_DRIVER) without the glvnd EGL vendor file.
    # At runtime --nv overlays these as usual.
    for f in \
        /usr/share/glvnd/egl_vendor.d/10_nvidia.json \
        /usr/share/egl/egl_external_platform.d/15_nvidia_gbm.json \
        /usr/share/vulkan/implicit_layer.d/nvidia_layers.json \
        /usr/share/nvidia/nvoptix.bin; do
        mkdir -p "$(dirname "${APPTAINER_ROOTFS}${f}")"
        touch "${APPTAINER_ROOTFS}${f}"
    done

%files
    # Vulkan
    nvidia_icd.json /etc/vulkan/icd.d/nvidia_icd.json

    # Python
    pyproject.toml /workspace/pyproject.toml
    uv.lock /workspace/uv.lock

    # Build-time shader cache warm-up (removed after use)
    warmup_shaders.py /workspace/warmup_shaders.py

%post
    # Install supporting packages
    export DEBIAN_FRONTEND=noninteractive

    apt update
    apt install -y \
        curl \
        ffmpeg \
        git \
        libatomic1 \
        libegl1 \
        libgl1 \
        libglib2.0-0* \
        libvulkan1 \
        vulkan-tools \
        libx11-6 \
        libxrandr2 \
        libxinerama1 \
        libxcursor1 \
        libgomp1 \
        libice6 \
        libquadmath0 \
        libsm6 \
        libxt6t64 \
        libxtst6 \
        zsh

    # Setup uv for Python stuff
    export UV_INSTALL_DIR=/bin/
    curl -LsSf https://astral.sh/uv/install.sh | sh

    # UV parameters
    # https://docs.astral.sh/uv/reference/environment/
    export UV_CONCURRENT_DOWNLOADS=100
    export UV_CONCURRENT_BUILDS=100
    export UV_CONCURRENT_INSTALLS=100
    export UV_COMPILE_BYTECODE=True
    export UV_LINK_MODE=copy
    
    # Python environment setup
    export ACCEPT_EULA=Y
    export OMNI_KIT_ACCEPT_EULA=YES
    
    cd /workspace
    uv python install 3.12
    uv venv .venv --python 3.12

    # Synchronize packages from frozen lockfile
    uv sync --frozen --no-dev --compile-bytecode

    # Bake the Kit/RTX shader cache (needs a GPU: apptainer build --nv, see sbatch_build.sh).
    # Kit writes its cache under ${KIT_DIR}/cache and data, which are read-only at runtime,
    # so the result is moved to /workspace/baked_kit_cache for jobs to seed a writable copy.
    # The driver-level cache is keyed to driver version + GPU; a mismatch just recompiles.
    KIT_DIR="/workspace/.venv/lib/python3.12/site-packages/isaacsim/kit"
    BAKED=/workspace/baked_kit_cache
    mkdir -p "${KIT_DIR}/cache" "${KIT_DIR}/data" "${KIT_DIR}/logs" "${BAKED}"
    # nvidia-smi is not bound in a writable build, so detect the GPU via device node + driver libs
    if [ -e /dev/nvidiactl ] && [ -e /.singularity.d/libs/libcuda.so.1 ]; then
        GPU_MODEL="$(cat /proc/driver/nvidia/gpus/*/information 2>/dev/null | sed -n 's/^Model:[[:space:]]*//p' | head -1)"
        DRIVER_VERSION="$(grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' /proc/driver/nvidia/version 2>/dev/null | head -1)"
        DRIVER_INFO="${GPU_MODEL:-unknown}, ${DRIVER_VERSION:-unknown}"
        echo "[bake] GPU visible: ${DRIVER_INFO}"
        WARMUP_TMP="$(mktemp -d)"
        mkdir -p "${WARMUP_TMP}/nvidia/omniverse" "${WARMUP_TMP}/nvidia/cache" "${WARMUP_TMP}/nvidia/logs"
        if ! VK_DRIVER_FILES=/etc/vulkan/icd.d/nvidia_icd.json vulkaninfo --summary >/dev/null 2>&1; then
            echo "[bake] ERROR: Vulkan instance creation failed:" >&2
            VK_LOADER_DEBUG=error,driver VK_DRIVER_FILES=/etc/vulkan/icd.d/nvidia_icd.json vulkaninfo --summary 2>&1 | tail -20 >&2
            exit 1
        fi
        echo "[bake] Vulkan OK"
        if ! env \
            HOME="${WARMUP_TMP}" \
            XDG_RUNTIME_DIR="${WARMUP_TMP}" \
            OMNI_USER_DATA_DIR="${WARMUP_TMP}/nvidia/omniverse" \
            OMNI_CACHE_DIR="${WARMUP_TMP}/nvidia/cache" \
            OMNI_LOG_DIR="${WARMUP_TMP}/nvidia/logs" \
            OMNI_KIT_ALLOW_ROOT=1 \
            VK_DRIVER_FILES=/etc/vulkan/icd.d/nvidia_icd.json \
            LD_LIBRARY_PATH="/.singularity.d/libs:${LD_LIBRARY_PATH:-}" \
            /workspace/.venv/bin/python /workspace/warmup_shaders.py; then
            echo "[bake] ERROR: shader warm-up failed" >&2
            exit 1
        fi
        echo "[bake] Shader cache locations after warm-up:"
        find "${KIT_DIR}" "${WARMUP_TMP}" -type d \( -name shadercache -o -name nv_shadercache \) -exec du -sh {} + || true
        echo "${DRIVER_INFO}" > "${BAKED}/DRIVER"
        mv "${KIT_DIR}/cache" "${BAKED}/cache"
        mv "${KIT_DIR}/data" "${BAKED}/data"
        rm -rf "${BAKED}"/cache/DerivedDataCache/app_instance_lock* "${KIT_DIR}/logs"/* "${WARMUP_TMP}"
        mkdir -p "${KIT_DIR}/cache" "${KIT_DIR}/data"
        du -sh "${BAKED}"
    else
        echo "[bake] WARNING: no GPU visible during build; skipping shader warm-up (build with --nv on a GPU node)"
    fi
    rm -f /workspace/warmup_shaders.py
    chmod -R 777 "${KIT_DIR}/cache" "${KIT_DIR}/data" "${KIT_DIR}/logs" "${BAKED}"

    # Project specific code dependencies
    if [ -f "/workspace/src/pyproject.toml" ]; then
        cd /workspace/src && uv pip install --no-deps -e .
    fi
    
    # Clean up
    apt clean
    apt autoremove
    rm -rf /var/lib/apt/lists/*    
    uv cache clean

    # Testing
    mkdir -p /root/.nvidia-omniverse /root/.local/share/ov /tmp/nvidia
    chmod -R 777 /root/.nvidia-omniverse /root/.local/share/ov /tmp/nvidia

%runscript
    exec python "$@"
    
%environment
    export PYTHONUNBUFFERED=1
    export LC_ALL=C.UTF-8
    export LANG=C.UTF-8

    export ACCEPT_EULA=Y
    export OMNI_KIT_ACCEPT_EULA=YES
    export OMNI_KIT_ALLOW_ROOT=1
    export QT_X11_NO_MITSHM=1
    export NVIDIA_VISIBLE_DEVICES=all
    export NVIDIA_DRIVER_CAPABILITIES="compute,utility,graphics,display"
    export VK_DRIVER_FILES="/etc/vulkan/icd.d/nvidia_icd.json"
    export VIRTUAL_ENV=/workspace/.venv
    export PATH=/workspace/.venv/bin:${PATH}

%test
    export PATH=/workspace/.venv/bin:${PATH}
    export OMNI_KIT_ACCEPT_EULA=YES
    export VK_DRIVER_FILES="/etc/vulkan/icd.d/nvidia_icd.json"

    # Setup %test to use /tmp for Omniverse loggers
    export HOME=/tmp
    export OMNI_USER_DATA_DIR=/tmp/nvidia/omniverse
    export OMNI_CACHE_DIR=/tmp/nvidia/cache
    
    # Verify FFmpeg is available
    ffmpeg -version >/dev/null

    # 1. Verify Python version is 3.12
    python -c "import sys; assert sys.version_info[:2] == (3, 12), f'Expected 3.12, got {sys.version}'"

    # 2. Verify PyTorch is compiled with CUDA support
    python -c "import torch; assert torch.version.cuda is not None, 'PyTorch was not built with CUDA!'"

    # 3. Verify packages import cleanly
    python -c "import rsl_rl; print('[TEST] rsl-rl imported successfully')"
    python -c "import isaacsim; print('[TEST] Isaac Sim imported successfully')"
    python -c "import isaaclab; print('[TEST] Isaac Lab imported successfully')"
